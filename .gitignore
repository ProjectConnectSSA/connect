# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.gitignore

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.kiro/specs/project-documentation/design.md
.kiro/specs/project-documentation/requirements.md
.kiro/specs/project-documentation/tasks.md
.kiro/steering/product.md
.kiro/steering/structure.md
.kiro/steering/tech.md
docs/README.md
docs/administration/README.md
docs/business/README.md
